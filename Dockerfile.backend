# Sử dụng Python 3.12 bản mỏng nhẹ
FROM python:3.12-slim

# Ngăn Python ghi file .pyc và ép output log ra console ngay lập tức
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_PYTHON_PREFERENCE=only-system

# Đặt thư mục làm việc trong container
WORKDIR /app

# Cài đặt uv (Trình quản lý gói)
RUN pip install uv

# Copy các tệp định nghĩa thư viện vào trước để tận dụng Docker cache
COPY pyproject.toml uv.lock ./

# Cài đặt các thư viện (chỉ lấy cho backend)
RUN uv sync

# Copy toàn bộ mã nguồn của backend vào container
COPY ./module_backend_infra /app/module_backend_infra
COPY ./configs /app/configs

# Expose port 8000 cho FastAPI
EXPOSE 8000

# Run inside the backend directory: the existing modules use ``core.*`` and
# ``domains.*`` imports and Alembic keeps its configuration there.
CMD ["sh", "-c", "cd /app/module_backend_infra && uv run uvicorn main:app --host 0.0.0.0 --port 8000"]
