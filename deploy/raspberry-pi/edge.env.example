# Copy this file to /etc/children-observer/edge.env on the Raspberry Pi.
# Do not commit the real file.  Keep the RTSP password URL-encoded.
EDGE_CAMERA_ID=camera_living_room_01
EDGE_RTSP_URL="rtsp://admin:<URL_ENCODED_PASSWORD>@192.168.2.106:554/cam/realmonitor?channel=1&subtype=1"
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp

# Laptop/server MQTT broker.  Reserve this IP in DHCP before long-running use.
MQTT_BROKER_HOST=192.168.2.67
MQTT_BROKER_PORT=1883
EDGE_MQTT_ENABLED=true
EDGE_REST_SYNC_ENABLED=false
EDGE_WS_RELAY_ENABLED=false

EDGE_MODEL_PATH=/opt/children-observer/weights/roi_detection/best.onnx
EDGE_DETECTION_FPS=5
EDGE_WEBRTC_FPS=10
EDGE_ONNX_INTRA_THREADS=2
EDGE_CONF_THRESHOLD=0.05
EDGE_ALERT_COOLDOWN_SECONDS=5
EDGE_VIEWER_GATED=false
