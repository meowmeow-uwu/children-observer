# Copy this file to /etc/children-observer/edge.env on the Raspberry Pi.
# Do not commit the real file.  Keep the RTSP password URL-encoded.
EDGE_CAMERA_ID=camera_living_room_01
EDGE_RTSP_URL="rtsp://admin:<URL_ENCODED_PASSWORD>@192.168.2.106:554/cam/realmonitor?channel=1&subtype=1"
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp

# Laptop/server MQTT broker.  Reserve this IP in DHCP before long-running use.
MQTT_BROKER_HOST=192.168.2.67
MQTT_BROKER_PORT=1883
EDGE_MQTT_ENABLED=true
EDGE_REST_SYNC_ENABLED=false
EDGE_WS_RELAY_ENABLED=false

EDGE_MODEL_PATH=/opt/children-observer/weights/roi_detection/best.onnx
EDGE_DETECTION_FPS=5
EDGE_WEBRTC_FPS=10
EDGE_ONNX_INTRA_THREADS=2
EDGE_CONF_THRESHOLD=0.05
EDGE_ALERT_COOLDOWN_SECONDS=5
EDGE_VIEWER_GATED=false

# Fall detection trial (ONNX model copied separately to the Pi).
EDGE_FALL_ENABLED=true
EDGE_FALL_MODEL_PATH=/opt/children-observer/weights/fall_detection/best-416.onnx
EDGE_FALL_FPS=2
EDGE_FALL_CONF_THRESHOLD=0.50
EDGE_FALL_STILL_SECONDS=1.0
# Send alert immediately after a measured fall transition; confirmed remains
# an informational state after one second of continued stillness.
EDGE_FALL_ALERT_ON_SUSPECTED=true
EDGE_FALL_COOLDOWN_SECONDS=30
EDGE_FALL_VELOCITY_THRESHOLD=0.15
EDGE_FALL_STILL_VELOCITY_THRESHOLD=0.04
EDGE_FALL_INPUT_SIZE=416
EDGE_FALL_ONNX_INTRA_THREADS=2
EDGE_FALL_PUBLISH_ALERTS=true
EDGE_FALL_METRICS_PATH=/var/lib/children-observer/fall-metrics.jsonl
