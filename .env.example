# ============================================
# AI Child Guardian - Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ---- General ----
APP_ENV=development
LOG_LEVEL=DEBUG

# ---- Dataset Paths ----
DATASET_CHILDSUN_PATH=./data/childsun
DATASET_VIOLENCE_PATH=./data/violence
MODEL_WEIGHTS_DIR=./weights

# ---- RTSP Camera ----
RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream1
RTSP_FPS=25
RTSP_RESOLUTION=1920x1080

# ---- AI Inference ----
INFERENCE_DEVICE=cuda:0
INFERENCE_CONF_THRESHOLD=0.5
INFERENCE_IOU_THRESHOLD=0.45
YOLO_MODEL_PATH=./weights/yolo26n.pt
POSE_MODEL_PATH=./weights/yolo26n-pose.pt
BEHAVIOR_MODEL_PATH=./weights/stgcn_violence.pt

# ---- Alert ----
ALERT_COOLDOWN_SECONDS=30
ALERT_CLIP_DURATION=7
ALERT_BUFFER_SECONDS=15

# ---- Security / Encryption ----
E2EE_SECRET_KEY=your-secret-key-here-change-in-production
HMAC_SECRET_KEY=your-hmac-key-here-change-in-production

# ---- Backend Server ----
BACKEND_URL=http://localhost:8000
AUTH_JWT_SECRET=your-jwt-secret-here
AUTH_2FA_ISSUER=AIChildGuardian

# ---- Federated Learning ----
FEDERATED_SERVER_URL=http://localhost:9000
OTA_UPDATE_INTERVAL_HOURS=24

# ---- Privacy ----
PRIVACY_BLUR_STRANGERS=true
PRIVACY_FACE_DETECTION_CONF=0.6
